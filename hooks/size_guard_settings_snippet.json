{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}} -I -S \"{{CLAUDE_HOME_FWD}}/hooks/size_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}} -I -S \"{{CLAUDE_HOME_FWD}}/hooks/size_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}} -I -S \"{{CLAUDE_HOME_FWD}}/hooks/size_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
